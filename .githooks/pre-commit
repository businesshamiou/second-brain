#!/usr/bin/env bash
# Refuses a commit containing a secret.
# Active for any Git client: agent, human, script.

set -u

VAULT_ROOT="$(git rev-parse --show-toplevel)"

# Invocation via `bash "$SCRIPT"` in both cases: the executable bit of the
# file on disk is not reliable (measured, build history, Windows/MSYS,
# noacl) and must never decide whether a check runs next or is skipped.

# --- Aggregating preflight (build history, Decision 154756) -----------------
# Every guardian runs, even if another has already failed: no more exit at the
# first `|| exit 1` (measured defect, build history -- "reciprocite au
# premier passage, chemin nu au second" ["reciprocity on the first pass, bare
# path on the second"]). A guardian that requires a prerequisite
# declares it in DEPS; if that prerequisite fails or is itself SKIPPED, the
# guardians that depend on it are SKIPPED (blocked by <x>), never run
# blindly -- the dependency propagates down the chain (transitive). The guardian
# scripts themselves are not modified -- only this chaining is.
# Order of the guardians kept (identical to the old sequential chaining):
# the preflight stamp (build history) becomes the first guardian of the same
# report rather than a separate silent wall -- a session whose
# preflight is stale must see, in the same report, that everything else was
# skipped because of it, not receive an isolated line with no context.

# --- Guardian 0: preflight stamp (build history) ----------------------------
preflight_guardian() {
  local stamp="$VAULT_ROOT/.claude/.preflight_stamp.json"
  if [ ! -f "$stamp" ]; then
    echo "REFUS : preflight absent. Remede : bash tools/session-preflight.sh"
    return 1
  fi
  if ! grep -qE '"ready"[[:space:]]*:[[:space:]]*true' "$stamp" 2>/dev/null; then
    echo "REFUS : preflight illisible ou ready != true. Remede : bash tools/session-preflight.sh"
    return 1
  fi
  if [ -n "$(find "$stamp" -mmin +1440 2>/dev/null)" ]; then
    echo "REFUS : preflight perime (> 1440 min). Remede : bash tools/session-preflight.sh"
    return 1
  fi
  return 0
}

# A guardian not found or its interpreter missing = FAIL (fail-closed),
# never a silent skip: "le controle ne peut pas verifier, il refuse."
# ["the check cannot verify, it refuses."]
uv_guardian() {
  local script="$1"
  if [ ! -f "$script" ]; then
    echo "REFUS : garde-fou introuvable : $script"
    return 1
  fi
  if ! command -v uv >/dev/null 2>&1; then
    echo "REFUS : uv introuvable, impossible d'executer $script"
    return 1
  fi
  uv run "$script"
}

bash_guardian() {
  local script="$1"
  if [ ! -f "$script" ]; then
    echo "REFUS : garde-fou introuvable : $script"
    return 1
  fi
  bash "$script"
}

declare -a G_NAME=()
declare -a G_CMD=()
declare -a G_DEP=()

add_guardian() { G_NAME+=("$1"); G_CMD+=("$2"); G_DEP+=("$3"); }

add_guardian "preflight"        "preflight_guardian" ""
add_guardian "reciprocite"      "uv_guardian \"$VAULT_ROOT/tools/check-obsolescence-guardrail.py\"" "preflight"
add_guardian "fraicheur-index"  "bash_guardian \"$VAULT_ROOT/tools/check-indexes-fresh.sh\"" "preflight"
add_guardian "poids-index"      "bash_guardian \"$VAULT_ROOT/tools/check-index-weight.sh\"" "fraicheur-index"
add_guardian "secrets"          "bash_guardian \"$VAULT_ROOT/tools/check-secrets.sh\"" "preflight"
add_guardian "liens"            "bash_guardian \"$VAULT_ROOT/tools/check-links.sh\"" "fraicheur-index"
add_guardian "chemins-affirmes" "bash_guardian \"$VAULT_ROOT/tools/check-asserted-paths.sh\"" "preflight"
add_guardian "manifeste"        "bash_guardian \"$VAULT_ROOT/tools/check-distribution-manifest.sh\"" "preflight"
add_guardian "sans-agents"      "bash_guardian \"$VAULT_ROOT/tools/check-no-slash-agents.sh\"" "preflight"
add_guardian "bit-execution"    "bash_guardian \"$VAULT_ROOT/tools/check-exec-bit-bare-scripts.sh\"" "preflight"

# Verdicts and outputs in indexed arrays, sharing the index of G_NAME,
# rather than in associative arrays: those only exist from bash
# 4.0 on, and macOS ships bash 3.2 (Mission 180). Same order, same values.
declare -a G_VERDICT=()
declare -a G_OUTPUT=()
FAIL_COUNT=0

index_of() {
  # Index of the guardian named $1, or -1. Ten entries: one scan is enough.
  local needle="$1" i=0
  while [ "$i" -lt "${#G_NAME[@]}" ]; do
    if [ "${G_NAME[$i]}" = "$needle" ]; then
      printf '%s' "$i"
      return 0
    fi
    i=$((i + 1))
  done
  printf '%s' "-1"
}

blocked() {
  # True if dependency $1 failed or was itself skipped (transitive).
  local idx
  idx="$(index_of "$1")"
  [ "$idx" -ge 0 ] || return 1
  local v="${G_VERDICT[$idx]:-}"
  [ "$v" = "FAIL" ] || [[ "$v" == SKIPPED* ]]
}

for i in "${!G_NAME[@]}"; do
  name="${G_NAME[$i]}"
  dep="${G_DEP[$i]}"

  if [ -n "$dep" ] && blocked "$dep"; then
    G_VERDICT[$i]="SKIPPED (blocked by $dep)"
    G_OUTPUT[$i]=""
    continue
  fi

  out="$(eval "${G_CMD[$i]}" 2>&1)"
  code=$?
  G_OUTPUT[$i]="$out"
  if [ "$code" -eq 0 ]; then
    G_VERDICT[$i]="PASS"
  else
    G_VERDICT[$i]="FAIL"
    FAIL_COUNT=$((FAIL_COUNT + 1))
  fi
done

echo "=== Guardian suite ==="
for i in "${!G_NAME[@]}"; do
  printf '%-18s %s\n' "${G_NAME[$i]}" "${G_VERDICT[$i]}"
done
echo "---"
for i in "${!G_NAME[@]}"; do
  case "${G_VERDICT[$i]}" in
    FAIL)
      echo "--- ${G_NAME[$i]} (FAIL) ---"
      echo "${G_OUTPUT[$i]}"
      ;;
  esac
done

if [ "$FAIL_COUNT" -gt 0 ]; then
  echo "REFUS : $FAIL_COUNT gardien(s) en echec sur ${#G_NAME[@]}."
  exit 1
fi

echo "PASS : ${#G_NAME[@]}/${#G_NAME[@]} gardiens (0 echec)."
exit 0
