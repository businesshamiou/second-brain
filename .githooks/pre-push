#!/usr/bin/env bash
# Refuses a push that would rewrite the remote history.
#
# Mission 165: explicit human gate. A single-use environment
# variable, VAULT_PUSH_GATE, whose value is the exact remote ref
# (refs/heads/<b> or refs/tags/<t>), authorizes for that ref ALONE a
# deletion or a non-fast-forward push; any other ref of the same push
# remains subject to the normal refusal (the gate does not leak from one ref to another).
# Before 165, the only gate this hook admitted was --no-verify -- a
# first tag v1.0.0-stable had to be deleted that way (handoff 2026-09-08),
# a defect recorded as an open point. Variable name measured against the
# Vault's conventions (BUILD_DIGEST_CAP_OVERRIDE, .obsolescence-guardrail-
# override): none corresponds to a single-use gate on a ref;
# VAULT_PUSH_GATE is therefore introduced, for lack of an existing convention to
# reuse.

set -u

REMOTE_REF_PREFIX="refs/heads/"
TAG_REF_PREFIX="refs/tags/"

# Label by prefix: a tag is not a branch (defect reported in the
# handoff 2026-09-08 -- the old hook displayed "branche" for a tag).
ref_label() {
  case "$1" in
    "$REMOTE_REF_PREFIX"*) printf 'branche' ;;
    "$TAG_REF_PREFIX"*) printf 'tag' ;;
    *) printf 'ref' ;;
  esac
}

ref_name() {
  case "$1" in
    "$REMOTE_REF_PREFIX"*) printf '%s' "${1#$REMOTE_REF_PREFIX}" ;;
    "$TAG_REF_PREFIX"*) printf '%s' "${1#$TAG_REF_PREFIX}" ;;
    *) printf '%s' "$1" ;;
  esac
}

GATE_VALUE="${VAULT_PUSH_GATE:-}"

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue

  label="$(ref_label "$remote_ref")"
  name="$(ref_name "$remote_ref")"
  gated=0
  if [ -n "$GATE_VALUE" ] && [ "$GATE_VALUE" = "$remote_ref" ]; then
    gated=1
  fi

  # Deletion of a remote ref.
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    if [ "$gated" -eq 1 ]; then
      echo "GATE accepté : $label $name (geste Owner)" >&2
      continue
    fi
    echo "REFUS : suppression de $label distante ($name)." >&2
    echo "Cette action requiert un gate humain explicite." >&2
    echo "Remède : VAULT_PUSH_GATE=$remote_ref git push …" >&2
    exit 1
  fi

  # New remote ref: authorized.
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  # The remote must be an ancestor of the local: otherwise, rewrite.
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    if [ "$gated" -eq 1 ]; then
      echo "GATE accepté : $label $name (geste Owner)" >&2
      continue
    fi
    echo "REFUS : ce push n est pas en avance rapide." >&2
    echo "  $label : $name" >&2
    echo "Il reecrirait l historique distant." >&2
    echo "Recupere le distant et rejoue ton travail par-dessus." >&2
    echo "Remède : VAULT_PUSH_GATE=$remote_ref git push …" >&2
    exit 1
  fi
done

exit 0
